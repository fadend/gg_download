{
  "manifest_version": 3,
  "name": "GG Download",
  "description": "Download Posts from Google Groups",
  "version": "1.1",
  "action": {
    "default_title": "Download Posts",
    "default_icon": "gg_download.png",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "downloads", "pageCapture", "scripting", "tabs"]
}
